local SkeletonLib = {}

function SkeletonLib.NewLine(info)
    local l = Drawing.new("Line")
    l.Visible = true
    l.Color = info.Color or Color3.fromRGB(0,255,0)
    l.Transparency = info.Transparency or 1
    l.Thickness = info.Thickness or 1
    return l
end

local Skeleton = {}
Skeleton.__index = Skeleton
Skeleton.Removed = false
Skeleton.Player = nil
Skeleton.Visible = false
Skeleton.Lines = {}
Skeleton.Color = Color3.fromRGB(50,220,90)
Skeleton.Alpha = 1
Skeleton.Thickness = 1
Skeleton.HeartbeatConn = nil

function Skeleton:UpdateStructure()
    if not self.Player.Character then return end
    self:RemoveLines()
    for _, part in next, self.Player.Character:GetChildren() do
        if part:IsA("BasePart") then
            for _, link in next, part:GetChildren() do
                if link:IsA("Motor6D") then
                    table.insert(self.Lines, {
                        SkeletonLib.NewLine({ Color = self.Color, Transparency = self.Alpha, Thickness = self.Thickness }),
                        SkeletonLib.NewLine({ Color = self.Color, Transparency = self.Alpha, Thickness = self.Thickness }),
                        part.Name,
                        link.Name,
                    })
                end
            end
        end
    end
end

function Skeleton:SetVisible(state)
    for _, l in pairs(self.Lines) do
        l[1].Visible = state
        l[2].Visible = state
    end
end

function Skeleton:SetColor(color)
    self.Color = color
    for _, l in pairs(self.Lines) do
        l[1].Color = color
        l[2].Color = color
    end
end

function Skeleton:SetAlpha(a)
    self.Alpha = a
    for _, l in pairs(self.Lines) do
        l[1].Transparency = a
        l[2].Transparency = a
    end
end

function Skeleton:SetThickness(t)
    self.Thickness = t
    for _, l in pairs(self.Lines) do
        l[1].Thickness = t
        l[2].Thickness = t
    end
end

function Skeleton:Update()
    if self.Removed then return end
    local Character = self.Player.Character
    if not Character then
        self:SetVisible(false)
        if not self.Player.Parent then self:Remove() end
        return
    end
    local Humanoid = Character:FindFirstChildOfClass("Humanoid")
    if not Humanoid then self:SetVisible(false); return end

    self:SetColor(self.Color)
    self:SetAlpha(self.Alpha)
    self:SetThickness(self.Thickness)

    local needRebuild = false
    for _, l in pairs(self.Lines) do
        local part = Character:FindFirstChild(l[3])
        if not part then
            l[1].Visible = false; l[2].Visible = false; needRebuild = true
        else
            local link = part:FindFirstChild(l[4])
            if not (link and link.Part0 and link.Part1) then
                l[1].Visible = false; l[2].Visible = false; needRebuild = true
            else
                local part0, part1 = link.Part0, link.Part1
                local p0p, v1 = Camera:WorldToViewportPoint(part0.CFrame.p)
                local p1p, v2 = Camera:WorldToViewportPoint(part1.CFrame.p)
                if v1 and v2 then
                    l[1].From = Vector2.new(p0p.x, p0p.y)
                    l[1].To   = Vector2.new(p1p.x, p1p.y)
                    l[1].Visible = true
                else
                    l[1].Visible = false
                end
                l[2].Visible = false
            end
        end
    end

    if needRebuild or #self.Lines == 0 then
        self:UpdateStructure()
    end
end

function Skeleton:Toggle()
    self.Visible = not self.Visible
    if self.Visible then
        self:RemoveLines()
        self:UpdateStructure()
        if self.HeartbeatConn then self.HeartbeatConn:Disconnect() end
        self.HeartbeatConn = RunService.Heartbeat:Connect(function()
            if not self.Visible then
                self:SetVisible(false)
                if self.HeartbeatConn then self.HeartbeatConn:Disconnect(); self.HeartbeatConn = nil end
                return
            end
            self:Update()
        end)
    else
        self:SetVisible(false)
        if self.HeartbeatConn then self.HeartbeatConn:Disconnect(); self.HeartbeatConn = nil end
    end
end

function Skeleton:RemoveLines()
    for _, l in pairs(self.Lines) do
        pcall(function() l[1]:Remove() end)
        pcall(function() l[2]:Remove() end)
    end
    self.Lines = {}
end

function Skeleton:Remove()
    self.Removed = true
    self.Visible = false
    if self.HeartbeatConn then self.HeartbeatConn:Disconnect(); self.HeartbeatConn = nil end
    self:RemoveLines()
end

function SkeletonLib.NewSkeleton(Player, Visible, Color, Alpha, Thickness)
    local s = setmetatable({}, Skeleton)
    s.Player = Player
    s.Bind = Player.UserId
    if Color then s:SetColor(Color) end
    if Alpha then s:SetAlpha(Alpha) end
    if Thickness then s:SetThickness(Thickness) end
    if Visible then s:Toggle() end
    return s
end

