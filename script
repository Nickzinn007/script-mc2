local Widgets = {}

function Widgets.toggle(parent, label, initial, callback)
    local card = Util.make("Frame", {
        Size = UDim2.new(1, -10, 0, 44),
        BackgroundColor3 = COLORS.panel, BorderSizePixel = 0, Parent = parent,
    })
    Util.corner(8).Parent = card
    Util.make("UIStroke", { Color = COLORS.track, Thickness = 1, Transparency = 0.3, Parent = card })

    Util.make("TextLabel", {
        Size = UDim2.new(1, -80, 1, 0), Position = UDim2.fromOffset(14, 0),
        BackgroundTransparency = 1, Text = label,
        TextColor3 = COLORS.text, Font = Enum.Font.GothamMedium, TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left, Parent = card,
    })

    local switch = Util.make("Frame", {
        Size = UDim2.fromOffset(42, 22), Position = UDim2.new(1, -56, 0.5, -11),
        BackgroundColor3 = initial and COLORS.accent or COLORS.track, Parent = card,
    })
    Util.corner(11).Parent = switch

    local knob = Util.make("Frame", {
        Size = UDim2.fromOffset(18, 18),
        Position = UDim2.new(0, initial and 22 or 2, 0.5, -9),
        BackgroundColor3 = COLORS.text, Parent = switch,
    })
    Util.corner(9).Parent = knob

    local hitbox = Util.make("TextButton", {
        Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
        Text = "", AutoButtonColor = false, Parent = card,
    })

    local state = initial
    local function apply(v, fire)
        state = v
        Util.tween(switch, { BackgroundColor3 = v and COLORS.accent or COLORS.track }, 0.15)
        Util.tween(knob, { Position = UDim2.new(0, v and 22 or 2, 0.5, -9) }, 0.15)
        if fire and callback then callback(v) end
    end
    hitbox.MouseButton1Click:Connect(function() apply(not state, true) end)
    return { 
        set = function(v) apply(v, true) end, 
        get = function() return state end,
        SetVisualOnly = function(v)
            state = v
            Util.tween(switch, { BackgroundColor3 = v and COLORS.accent or COLORS.track }, 0.15)
            Util.tween(knob, { Position = UDim2.new(0, v and 22 or 2, 0.5, -9) }, 0.15)
        end
    }
end

function Widgets.slider(parent, label, minV, maxV, initial, isFloat, callback)
    local card = Util.make("Frame", {
        Size = UDim2.new(1, -10, 0, 82),
        BackgroundColor3 = COLORS.panel, BorderSizePixel = 0, Parent = parent,
    })
    Util.corner(8).Parent = card
    Util.make("UIStroke", { Color = COLORS.track, Thickness = 1, Transparency = 0.3, Parent = card })

    Util.make("TextLabel", {
        Size = UDim2.new(1, -100, 0, 24), Position = UDim2.fromOffset(14, 8),
        BackgroundTransparency = 1, Text = label,
        TextColor3 = COLORS.text, Font = Enum.Font.GothamMedium, TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left, Parent = card,
    })

    local valueBoxFrame = Util.make("Frame", {
        Size = UDim2.fromOffset(64, 24), Position = UDim2.new(1, -78, 0, 6),
        BackgroundColor3 = COLORS.panelAlt, BorderSizePixel = 0, Parent = card,
    })
    Util.corner(6).Parent = valueBoxFrame
    local valueBox = Util.make("TextBox", {
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
        Text = tostring(initial), TextColor3 = COLORS.text,
        Font = Enum.Font.GothamBold, TextSize = 13,
        ClearTextOnFocus = false, Parent = valueBoxFrame,
    })

    Util.make("TextLabel", {
        Size = UDim2.new(1, -30, 0, 14), Position = UDim2.fromOffset(14, 34),
        BackgroundTransparency = 1, Text = string.format("min %d | max %d | passo %d", minV, maxV, isFloat and 1 or math.max(1, math.floor((maxV-minV)/100))),
        TextColor3 = COLORS.textDim, Font = Enum.Font.Gotham, TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left, Parent = card,
    })

    local track = Util.make("Frame", {
        Size = UDim2.new(1, -28, 0, 10), Position = UDim2.new(0, 14, 1, -18),
        BackgroundColor3 = COLORS.track, Parent = card,
    })
    Util.corner(5).Parent = track

    local fill = Util.make("Frame", {
        Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = COLORS.accent, Parent = track,
    })
    Util.corner(5).Parent = fill

    local knob = Util.make("Frame", {
        Size = UDim2.fromOffset(12, 12), Position = UDim2.new(0, -6, 0.5, -6),
        BackgroundColor3 = COLORS.text, Parent = fill,
    })
    Util.corner(6).Parent = knob

    local current = initial
    local function clamp(v) return math.clamp(v, minV, maxV) end
    local function round(v) return isFloat and math.floor(v * 100) / 100 or math.floor(v + 0.5) end
    local function render(v)
        local pct = math.clamp((v - minV) / (maxV - minV), 0, 1)
        fill.Size = UDim2.new(pct, 0, 1, 0)
        valueBox.Text = tostring(round(v))
        knob.Position = UDim2.new(1, -6, 0.5, -6)
    end
    local function setValue(v, fire)
        v = clamp(round(v)); current = v; render(v)
        if fire and callback then callback(v) end
    end
    render(current)

    local dragging = false
    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            local pos = input.Position.X - track.AbsolutePosition.X
            setValue(minV + (pos / math.max(1, track.AbsoluteSize.X)) * (maxV - minV), true)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local pos = input.Position.X - track.AbsolutePosition.X
            setValue(minV + (pos / math.max(1, track.AbsoluteSize.X)) * (maxV - minV), true)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
    valueBox.FocusLost:Connect(function()
        local n = tonumber(valueBox.Text)
        if n then setValue(n, true) else valueBox.Text = tostring(round(current)) end
    end)
    return { set = function(v) setValue(v, true) end, get = function() return current end }
end

function Widgets.keybind(parent, label, initialKey, callback)
    local card = Util.make("Frame", {
        Size = UDim2.new(1, -10, 0, 44),
        BackgroundColor3 = COLORS.panel, BorderSizePixel = 0, Parent = parent,
    })
    Util.corner(8).Parent = card
    Util.make("UIStroke", { Color = COLORS.track, Thickness = 1, Transparency = 0.3, Parent = card })

    Util.make("TextLabel", {
        Size = UDim2.new(1, -100, 1, 0), Position = UDim2.fromOffset(14, 0),
        BackgroundTransparency = 1, Text = label,
        TextColor3 = COLORS.text, Font = Enum.Font.GothamMedium, TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left, Parent = card,
    })

    local btn = Util.make("TextButton", {
        Size = UDim2.fromOffset(80, 28), Position = UDim2.new(1, -94, 0.5, -14),
        BackgroundColor3 = COLORS.panelAlt, Text = getKeyName(initialKey),
        TextColor3 = COLORS.text, Font = Enum.Font.GothamBold, TextSize = 12,
        AutoButtonColor = false, Parent = card,
    })
    Util.corner(6).Parent = btn

    local hitbox = Util.make("TextButton", {
        Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
        Text = "", AutoButtonColor = false, Parent = card,
    })

    local currentKey = initialKey

    local function startBinding()
        if KeybindState.isBinding then return end
        KeybindState.isBinding = true
        btn.Text = "..."
        btn.TextColor3 = COLORS.accent
    end

    hitbox.MouseButton1Click:Connect(startBinding)

    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if not KeybindState.isBinding then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 then return end

        currentKey = input.KeyCode ~= Enum.KeyCode.Unknown and input.KeyCode or input.UserInputType
        btn.Text = getKeyName(currentKey)
        btn.TextColor3 = COLORS.text
        KeybindState.isBinding = false
        
        if callback then callback(currentKey) end
    end)

    return { get = function() return currentKey end }
end

