local function healthColor(hp)
    hp = math.clamp(hp, 0, 1)
    if hp > 0.5 then
        local t = (hp - 0.5) * 2
        return Color3.fromRGB(math.floor((1 - t) * 255), 255, 60)
    else
        return Color3.fromRGB(255, math.floor(hp * 2 * 255), 60)
    end
end

