local function colorFor(plr)
    if plr.Team and LocalPlayer.Team and plr.Team == LocalPlayer.Team then
        return Config.ESP.AllyColor
    end
    return Config.ESP.EnemyColor
end

local function updateESP()
    if not Config.ESP.Enabled then
        for _, d in pairs(ESP.store) do
            d.box.Visible = false
            d.healthBg.Visible = false
            d.name.Visible = false
            d.dist.Visible = false
        end
        return
    end

    for plr, d in pairs(ESP.store) do
        if not plr.Parent then destroyESP(plr); continue end
        local char, hum, hrp = Util.getCharacter(plr)

        if not char or not hrp then
            d.box.Visible = false
            d.healthBg.Visible = false
            d.name.Visible = false
            d.dist.Visible = false
            continue
        end

        local head = char:FindFirstChild("Head")
        if not head then
            d.box.Visible = false
            d.healthBg.Visible = false
            d.name.Visible = false
            d.dist.Visible = false
            continue
        end

        local headPos, headOn, headZ = Util.worldToViewport(head.Position + Vector3.new(0, 0.5, 0))
        local rootPos, rootOn, rootZ = Util.worldToViewport(hrp.Position - Vector3.new(0, 2.5, 0))

        if not headOn or not rootOn or headZ < 0 or rootZ < 0 then
            d.box.Visible = false
            d.healthBg.Visible = false
            d.name.Visible = false
            d.dist.Visible = false
            continue
        end

        local height = math.abs(headPos.Y - rootPos.Y)
        local width = height / 2.2
        local color = colorFor(plr)

        if Config.ESP.Box then
            d.box.Visible = true
            d.box.Size = UDim2.fromOffset(width, height)
            d.box.Position = UDim2.fromOffset(headPos.X - width/2, headPos.Y)
            d.boxStroke.Color = color
            d.boxStroke.Thickness = Config.ESP.BoxThickness
        else
            d.box.Visible = false
        end

        if Config.ESP.Health then
            d.healthBg.Visible = true
            d.healthBg.Size = UDim2.fromOffset(3, height)
            d.healthBg.Position = UDim2.fromOffset(headPos.X - width/2 - 6, headPos.Y)

            local hp = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
            d.healthFg.Size = UDim2.new(1, 0, hp, 0)
            d.healthFg.Position = UDim2.new(0, 0, 1 - hp, 0)
            d.healthFg.BackgroundColor3 = healthColor(hp)
        else
            d.healthBg.Visible = false
        end

        if Config.ESP.Name then
            d.name.Visible = true
            d.name.Size = UDim2.fromOffset(width + 40, 16)
            d.name.Position = UDim2.fromOffset(headPos.X - (width+40)/2, headPos.Y - 18)
            d.name.Text = plr.Name
            d.name.TextColor3 = color
            d.name.TextSize = math.max(9, Config.ESP.TextSize - 2)
        else
            d.name.Visible = false
        end

        if Config.ESP.Distance then
            d.dist.Visible = true
            d.dist.Size = UDim2.fromOffset(width + 40, 12)
            d.dist.Position = UDim2.fromOffset(headPos.X - (width+40)/2, headPos.Y + height + 2)
            local dist = math.floor((Camera.CFrame.Position - hrp.Position).Magnitude)
            d.dist.Text = dist .. "m"
            d.dist.TextColor3 = color
        else
            d.dist.Visible = false
        end
    end
end

