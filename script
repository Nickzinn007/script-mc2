local function getKeyName(key)
    if typeof(key) == "EnumItem" then
        if key.EnumType == Enum.KeyCode then
            return key.Name
        elseif key.EnumType == Enum.UserInputType then
            return key.Name:gsub("MouseButton", "Mouse ")
        end
    end
    return tostring(key)
end

--=====================================================================
-- UTIL
--=====================================================================
local Util = {}

function Util.make(class, props, children)
    local inst = Instance.new(class)
    for k, v in pairs(props or {}) do pcall(function() inst[k] = v end) end
    for _, c in ipairs(children or {}) do c.Parent = inst end
    return inst
end

function Util.corner(r)
    return Util.make("UICorner", { CornerRadius = UDim.new(0, r or 8) })
end

function Util.tween(inst, props, t)
    local tw = TweenService:Create(inst, TweenInfo.new(t or 0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
    tw:Play()
    return tw
end

function Util.getCharacter(plr)
    local char = plr and plr.Character
    if not char then return nil end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp or hum.Health <= 0 then return nil end
    return char, hum, hrp
end

function Util.worldToViewport(pos)
    if not Camera then return Vector2.zero, false, 0 end
    local p, on = Camera:WorldToViewportPoint(pos)
    return Vector2.new(p.X, p.Y), on, p.Z
end

