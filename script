--=====================================================================
-- AIMBOT PLAYER LIST (whitelist / skip)
--=====================================================================
local AimbotList = {}
AimbotList.Ignored   = {}   -- [UserId] = true
AimbotList.Rows      = {}   -- [UserId] = { frame, dot, name, plr }
AimbotList.Container = nil

function AimbotList.IsIgnored(plr)
    return plr and AimbotList.Ignored[plr.UserId] == true
end

function AimbotList.Paint(plr)
    local row = AimbotList.Rows[plr.UserId]
    if not row then return end
    local off = AimbotList.IsIgnored(plr)
    row.dot.BackgroundColor3  = off and COLORS.danger or COLORS.track
    row.name.TextColor3       = off and COLORS.danger or COLORS.text
end

function AimbotList.Toggle(plr)
    if AimbotList.Ignored[plr.UserId] then
        AimbotList.Ignored[plr.UserId] = nil
    else
        AimbotList.Ignored[plr.UserId] = true
    end
    AimbotList.Paint(plr)
end

function AimbotList.BuildRow(plr)
    if plr == LocalPlayer then return end
    if AimbotList.Rows[plr.UserId] then return end
    if not AimbotList.Container then return end

    local row = Util.make("Frame", {
        Size = UDim2.new(1, -8, 0, 26),
        BackgroundColor3 = COLORS.panelAlt,
        BackgroundTransparency = 0.4,
        BorderSizePixel = 0,
        Parent = AimbotList.Container,
    })
    Util.corner(6).Parent = row

    local dot = Util.make("Frame", {
        Size = UDim2.fromOffset(10, 10),
        Position = UDim2.new(0, 8, 0.5, -5),
        BackgroundColor3 = COLORS.track,
        BorderSizePixel = 0,
        Parent = row,
    })
    Util.corner(5).Parent = dot

    local name = Util.make("TextLabel", {
        Size = UDim2.new(1, -60, 1, 0),
        Position = UDim2.fromOffset(26, 0),
        BackgroundTransparency = 1,
        Text = plr.Name,
        TextColor3 = COLORS.text,
        Font = Enum.Font.GothamMedium,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = row,
    })

    local hitbox = Util.make("TextButton", {
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        Text = "",
        AutoButtonColor = false,
        Parent = row,
    })
    hitbox.MouseButton1Click:Connect(function() AimbotList.Toggle(plr) end)

    AimbotList.Rows[plr.UserId] = { frame = row, dot = dot, name = name, plr = plr }
    AimbotList.Paint(plr)
end

function AimbotList.RemoveRow(plr)
    local row = AimbotList.Rows[plr.UserId]
    if not row then return end
    if row.frame then row.frame:Destroy() end
    AimbotList.Rows[plr.UserId] = nil
    AimbotList.Ignored[plr.UserId] = nil
end

function AimbotList.Refresh()
    if not AimbotList.Container then return end
    for _, plr in ipairs(Players:GetPlayers()) do
        AimbotList.BuildRow(plr)
    end
    for uid, row in pairs(AimbotList.Rows) do
        if not row.plr.Parent then
            AimbotList.RemoveRow(row.plr)
        end
    end
end

function AimbotList.MakePanel(parent)
    sectionDivider(parent, "PLAYER LIST — CLICK TO SKIP")

    local holder = Util.make("Frame", {
        Size = UDim2.new(1, -10, 0, 220),
        BackgroundColor3 = COLORS.panel,
        BackgroundTransparency = 0.2,
        BorderSizePixel = 0,
        Parent = parent,
    })
    Util.corner(8).Parent = holder
    Util.make("UIStroke", { Color = COLORS.track, Thickness = 1, Transparency = 0.3, Parent = holder })

    local scroll = Util.make("ScrollingFrame", {
        Size = UDim2.new(1, -12, 1, -12),
        Position = UDim2.fromOffset(6, 6),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 4,
        ScrollBarImageColor3 = COLORS.accent,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        Parent = holder,
    })

    local layout = Util.make("UIListLayout", {
        Padding = UDim.new(0, 4),
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = scroll,
    })

    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        scroll.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 8)
    end)

    AimbotList.Container = scroll

    Players.PlayerAdded:Connect(function(plr)
        task.wait(0.5)
        AimbotList.BuildRow(plr)
    end)
    Players.PlayerRemoving:Connect(function(plr)
        AimbotList.RemoveRow(plr)
    end)

    AimbotList.Refresh()
    return holder
end

