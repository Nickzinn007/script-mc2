--=====================================================================
local Aimbot = {}

function Aimbot.getTarget()
    if not Camera then return nil end
    local vp = Camera.ViewportSize
    local center = Vector2.new(vp.X / 2, vp.Y / 2)
    local limit = math.min(Config.Aimbot.SelectionRadius, Config.FOV.Radius)
    local bestPart, bestDist

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        if AimbotList.IsIgnored(plr) then continue end
        if Config.Aimbot.TeamCheck and plr.Team and LocalPlayer.Team and plr.Team == LocalPlayer.Team then continue end

        local char, _, hrp = Util.getCharacter(plr)
        if not char then continue end

        local part = char:FindFirstChild(Config.Aimbot.TargetPart)
                     or char:FindFirstChild("Head")
                     or char:FindFirstChild("Torso")
                     or char:FindFirstChild("UpperTorso")
                     or hrp

        if not part then continue end

        local sp, on, z = Util.worldToViewport(part.Position)
        if not on or z < 0 then continue end

        local d = (sp - center).Magnitude
        if d <= limit and (not bestDist or d < bestDist) then
            bestPart, bestDist = part, d
        end
    end
    return bestPart
end

function Aimbot.hasLineOfSight(targetPart, ignoreList)
    local camPos = Camera.CFrame.Position
    local direction = (targetPart.Position - camPos)
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.FilterDescendantsInstances = ignoreList

    local rayResult = Workspace:Raycast(camPos, direction, rayParams)

    if rayResult then
        if rayResult.Instance:IsDescendantOf(targetPart.Parent) then
            return true
        end
        return false
    end
    return true
end

function Aimbot.step(dt)
    if not Config.Aimbot.Enabled or not Camera then return end

    -- 1. Verifica se a tecla de atalho está pressionada
    local key = Config.Aimbot.Keybind
    local isPressed = false
    if typeof(key) == "EnumItem" then
        if key.EnumType == Enum.UserInputType then
            isPressed = UserInputService:IsMouseButtonPressed(key)
        elseif key.EnumType == Enum.KeyCode then
            isPressed = UserInputService:IsKeyDown(key)
        end
    end
    if not isPressed then return end

    -- 2. Verifica se tem uma ferramenta (arma) equipada
    local char = LocalPlayer.Character
    if not char then return end
    
    local hasTool = false
    for _, child in ipairs(char:GetChildren()) do
        if child:IsA("Tool") then
            hasTool = true
            break
        end
    end
    
    -- Se não estiver com arma na mão, cancela o aimbot
    if not hasTool then return end

    -- 3. Puxa o alvo
    local targetPart = Aimbot.getTarget()
    if not targetPart then return end

    if Config.Aimbot.WallCheck then
        local ignoreList = { LocalPlayer.Character, Camera }
        if not Aimbot.hasLineOfSight(targetPart, ignoreList) then
            return
        end
    end

    -- Snap direto para o alvo
    local camPos = Camera.CFrame.Position
    local targetPos = targetPart.Position
    Camera.CFrame = CFrame.lookAt(camPos, targetPos)
end

-- BindToRenderStep garante que a câmera cole DEPOIS do Roblox atualizar
RunService:BindToRenderStep("MCAimbotCamera", Enum.RenderPriority.Camera.Value + 1, function(dt)
    pcall(Aimbot.step, dt)
end)

